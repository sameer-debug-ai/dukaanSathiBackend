# Port the API listens on
PORT=4000
NODE_ENV=development

# MongoDB connection string. Transactions require a replica set: MongoDB Atlas,
# the docker-compose mongo service, or a local mongod converted with
# scripts/enable-mongo-replica.ps1. A standalone mongod works but without transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/dukaansathi
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dukaansathi
# Use "memory" for a throwaway in-memory replica set (data is lost on restart).
# MONGODB_URI=memory

# JWT secrets - use long random strings in production
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Anthropic Claude API (server-side only - never expose to the client)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# High-accuracy speech-to-text (optional). Used by the app on phones without browser speech
# recognition (iOS Safari) or when "High accuracy mode" is on. Any Whisper-compatible API:
#   none    - off (default)
#   openai  - https://api.openai.com/v1, model whisper-1
#   groq    - https://api.groq.com/openai/v1, model whisper-large-v3-turbo
#   whisper - your own Whisper-compatible server (set STT_BASE_URL; key optional)
STT_PROVIDER=none
STT_API_KEY=
# Optional overrides of the provider defaults above.
STT_BASE_URL=
STT_MODEL=

# Daily "Aaj ke reminders" job, cron syntax in Asia/Kolkata time (default 9 AM). Empty = off;
# the dashboard still builds the list when it is opened.
REMINDER_CRON=0 9 * * *

# Frontend origin for CORS (comma separated for multiple)
CLIENT_URL=http://localhost:4200

# Seed a demo shop (login 9876543210 / demo123) when the database is empty.
# Local trials only: keep false for any shared/deployed server. Ignored when NODE_ENV=production.
AUTO_SEED=false
